# Copie para .env.local (dev) ou configure como env vars do deploy (Vercel).
# Nenhuma dessas variáveis é lida no browser — tudo é usado só em Route
# Handlers / Server Components.
#
# Alternativa: preencha tudo isso em /configuracao (SQLite local) em vez de
# editar este arquivo — o banco tem prioridade sobre as env vars abaixo. Fica
# mais fácil de trocar de app/merchant sem redeploy. Ver README.md.

# sandbox | production
APPMAX_ENV=sandbox

# structured | legacy — contrato de callbacks do AppmaxScripts.init().
# `structured` (padrão) é o objeto de opções, com um callback por evento
# (onTokenize/onIp) e onError estruturado — a forma recomendada para código
# novo. `legacy` é a assinatura posicional, com o onSuccess polimórfico; ela
# continua suportada e está aqui só para comparar os dois contratos no mesmo
# checkout. Ver https://docs.appmax.com.br/guides/appmax-js
# APPMAX_SCRIPT_API=legacy

# Normalmente NÃO precisa definir: a URL pública é detectada a partir do Host
# da requisição (ver lib/appmax/config.ts#getAppBaseUrl), então funciona tanto
# em localhost quanto atrás de um túnel que muda de URL. Defina só como
# fallback, para um proxy que não repassa Host/X-Forwarded-* corretamente.
# APP_BASE_URL=https://SEU-DOMINIO-PUBLICO

# Credenciais do APLICATIVO (painel Appmax → Consultar Aplicativo → Desenvolver).
# Servem só para o fluxo de instalação (/app/authorize, /app/client/generate).
APPMAX_APP_UUID=
APPMAX_APP_NUMERICAL_ID=
APPMAX_APP_CLIENT_ID=
APPMAX_APP_CLIENT_SECRET=

# Identifica esta instalação (equivalente a um store_id seu). Qualquer string.
APPMAX_EXTERNAL_KEY=appstore-demo-nextjs

# NÃO existe APPMAX_EXTERNAL_ID. O `external_id` da loja é lido
# EXCLUSIVAMENTE do banco (gerado no /setup, editável em /configuracao): uma
# env var aqui venceria silenciosamente o valor salvo pela instalação, e o SDK
# passaria a mandar um id que a Appmax não conhece — 404 "Merchant not found"
# em toda tokenização.

# Credenciais do MERCHANT — geradas ao concluir o fluxo em /setup. Em dev
# local já são salvas no banco automaticamente; preencha aqui só em runtimes
# com filesystem somente-leitura.
APPMAX_MERCHANT_CLIENT_ID=
APPMAX_MERCHANT_CLIENT_SECRET=
